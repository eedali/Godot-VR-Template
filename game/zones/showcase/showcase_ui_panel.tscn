[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://game/zones/showcase/showcase_ui_panel.gd" id="1_panel"]

[node name="ShowcaseUIPanel" type="PanelContainer"]
offset_right = 400.0
offset_bottom = 240.0
script = ExtResource("1_panel")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Info" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Point with the laser and pull the trigger (or poke the screen with your finger)."
autowrap_mode = 2

[node name="ClickButton" type="Button" parent="Margin/VBox"]
layout_mode = 2
text = "Click me"

[node name="Counter" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Not clicked yet"

[node name="TextField" type="LineEdit" parent="Margin/VBox"]
layout_mode = 2
placeholder_text = "Type here with the virtual keyboard"

[connection signal="pressed" from="Margin/VBox/ClickButton" to="." method="_on_click_button_pressed"]
